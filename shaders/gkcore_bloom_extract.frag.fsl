#include "gkcore_postprocess.fsl.h"

STRUCT(PostProcessVertex)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(PostProcessVertex input)
{
    INIT_MAIN;
    float3 color = max(SampleTex2D(gPostTextures[0], gPostSampler, input.UV).rgb, float3(0.0, 0.0, 0.0));
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float knee = max(gPostConstants.Parameters.x, 0.0001);
    float threshold = gPostConstants.Parameters.y;
    float softLimit = clamp(luminance - threshold + knee, 0.0, 2.0 * knee);
    float softContribution = softLimit * softLimit / (4.0 * knee);
    float contribution = max(luminance - threshold, softContribution) / max(luminance, 0.0001);
    RETURN(float4(color * contribution, 1.0));
}
