#include "gkcore_postprocess.fsl.h"

STRUCT(PostProcessVertex)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD);
};

/**
 * Maps scene-linear RGB into display range with a soft shoulder.
 */
float3 ToneMapAces(float3 color)
{
    color = max(color, float3(0.0, 0.0, 0.0));
    return saturate((color * (2.51 * color + 0.03)) / (color * (2.43 * color + 0.59) + 0.14));
}

ROOT_SIGNATURE(DefaultRootSignature)
/**
 * Combines scene and bloom, then applies display tone and color adjustments.
 */
float4 PS_MAIN(PostProcessVertex input)
{
    INIT_MAIN;
    float3 scene = SampleTex2D(gPostSourceTexture, gPostSampler, input.UV).rgb;
    float3 bloom = SampleTex2D(gPostBloomTexture, gPostSampler, input.UV).rgb;
    float3 color = (scene + bloom * gPostConstants.Parameters.x) * gPostConstants.Parameters.y;
    if (gPostConstants.Parameters.z > 0.5)
        color = ToneMapAces(color);
    else
        color = saturate(color);

    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    color = luminance + (color - luminance) * gPostConstants.ColorAdjustment.x;
    color = saturate((color - 0.5) * gPostConstants.ColorAdjustment.y + 0.5);
    RETURN(float4(color, 1.0));
}
