/**
 * 専用PBR model layoutから受け取る頂点入力。
 */
STRUCT(VSInput)
{
    // 変換済み位置を受け取る。
    DATA(float4, Position, POSITION);
    // 基本色と頂点alphaを受け取る。
    DATA(float4, Color, COLOR);
    // 基本色画像を参照する座標。
    DATA(float2, UV, TEXCOORD0);
    // world空間の法線。
    DATA(float3, WorldNormal, NORMAL);
    // cameraから頂点へ向かう方向量。
    DATA(float3, ViewDirection, TEXCOORD1);
    // PBR金属度と粗さ。
    DATA(float2, MetallicRoughness, TEXCOORD2);
    // アルファ抜きの有効値と境界値。
    DATA(float2, AlphaMaskCutoff, TEXCOORD3);
    // 材質画像の独立した座標。
    DATA(float2, MetallicRoughnessUV, TEXCOORD4);
    // 法線画像の横方向と鏡映の符号。
    DATA(float4, WorldTangent, TANGENT);
    // 法線画像の独立した座標。
    DATA(float2, NormalUV, TEXCOORD5);
    // 法線画像の有効値とXYの倍率。
    DATA(float2, NormalParameters, TEXCOORD6);
    // 自己発光画像の独立した座標。
    DATA(float2, EmissiveUV, TEXCOORD7);
    // 自己発光のRGB係数と強度。
    DATA(float4, EmissiveFactorStrength, TEXCOORD8);
    // 遮蔽画像のUVと、画像なしでは0となる効果量。
    DATA(float3, OcclusionUVStrength, TEXCOORD9);
};

/**
 * 画素shaderへ渡すmodel表面と照明属性。
 */
STRUCT(VSOutput)
{
    // rasterizerへ渡すclip空間位置。
    DATA(float4, Position, SV_Position);
    // 基本色と頂点alpha。
    DATA(float4, Color, COLOR);
    // 基本色画像の座標。
    DATA(float2, UV, TEXCOORD0);
    // world空間の法線。
    DATA(float3, WorldNormal, TEXCOORD1);
    // cameraから頂点へ向かう方向量。
    DATA(float3, ViewDirection, TEXCOORD2);
    // PBR金属度と粗さ。
    DATA(float2, MetallicRoughness, TEXCOORD3);
    // 材質ごとの値を補間せず、画素の切り抜きへ渡す。
    DATA(FLAT(float2), AlphaMaskCutoff, TEXCOORD4);
    // 材質画像へ渡す座標。
    DATA(float2, MetallicRoughnessUV, TEXCOORD5);
    // 補間後に法線と直交させる接線と向きの符号。
    DATA(float4, WorldTangent, TEXCOORD6);
    // 法線画像の座標。
    DATA(float2, NormalUV, TEXCOORD7);
    // 材質の有効値とXY倍率は補間しない。
    DATA(FLAT(float2), NormalParameters, TEXCOORD8);
    // 自己発光画像の座標。
    DATA(float2, EmissiveUV, TEXCOORD9);
    // RGB係数とHDR強度は材質ごとに固定して渡す。
    DATA(FLAT(float4), EmissiveFactorStrength, TEXCOORD10);
    // 環境光を弱める画像の独立した座標。
    DATA(float2, OcclusionUV, TEXCOORD11);
    // 効果量は材質ごとに固定し、頂点間で補間しない。
    DATA(FLAT(float), OcclusionStrength, TEXCOORD12);
};

/**
 * 投影済み表面、照明、材質属性を画素shaderへ渡す。
 */
ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput input)
{
    INIT_MAIN;
    // 次段shaderへ渡す属性一式。
    VSOutput output;
    output.Position = input.Position;
    output.Color = input.Color;
    output.UV = input.UV;
    output.WorldNormal = input.WorldNormal;
    output.ViewDirection = input.ViewDirection;
    output.MetallicRoughness = input.MetallicRoughness;
    output.AlphaMaskCutoff = input.AlphaMaskCutoff;
    output.MetallicRoughnessUV = input.MetallicRoughnessUV;
    output.WorldTangent = input.WorldTangent;
    output.NormalUV = input.NormalUV;
    output.NormalParameters = input.NormalParameters;
    output.EmissiveUV = input.EmissiveUV;
    output.EmissiveFactorStrength = input.EmissiveFactorStrength;
    output.OcclusionUV = input.OcclusionUVStrength.xy;
    output.OcclusionStrength = input.OcclusionUVStrength.z;
    RETURN(output);
}
