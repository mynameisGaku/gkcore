root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true

[*.{h,hpp,cpp,cxx,inl,fsl,hlsl,py,ps1}]
charset = utf-8-bom

[*.{md,bat,json,svg,yml,yaml}]
charset = utf-8

[CMakeLists.txt]
charset = utf-8-bom

[*.{cmake,in}]
charset = utf-8-bom

[*.md]
indent_size = 2

[{third_party,.devtools,build}/**]
indent_style = unset
indent_size = unset
end_of_line = unset
insert_final_newline = unset
charset = unset
